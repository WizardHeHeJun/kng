# ── 只保留插件本体 + marketplace 配置 ──

# 忽略根目录所有内容，再白名单放行
/*
!kng-plugin/
!.claude-plugin/
!bin/
!package.json
!.gitignore
!README.md
!LICENSE

# ── 插件目录内的忽略规则 ──

# Python
__pycache__/
*.py[cod]
*.pyo

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database
*.db

# ── 个人知识库内容（用户自行导入，不上传） ──

# 能力库（用户自行提供技能文件 + 自动生成的索引）
kng-plugin/kb/capability/*
!kng-plugin/kb/capability/.gitkeep

# 项目知识库（用户按自己项目填充）
kng-plugin/kb/projects/
/kb/

# Logs
*.log

# Claude Code session data
.claude/

# Claude Code instruction files
CLAUDE.md
