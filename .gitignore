# ── 只保留插件本体 + marketplace 配置 ──

# 忽略根目录所有内容，再白名单放行
/*
!kng-plugin/
!.claude-plugin/
!bin/
!package.json
!.gitignore
!README.md
!LICENSE

# ── 插件目录内的忽略规则 ──

# Python
__pycache__/
*.py[cod]
*.pyo

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database
*.db

# ── 个人知识库内容（用户自行导入，不上传） ──

# 编号QA能力知识文件（个人经验沉淀）
kng-plugin/kb/capability/[0-9][0-9]-*.md

# 自动生成的索引文件（由 generate_registry.py 和 /kng-init 生成）
kng-plugin/kb/capability/skill-registry.yaml
kng-plugin/kb/capability/synonym-aliases.yaml

# 项目知识库（用户按自己项目填充）
kng-plugin/kb/projects/
/kb/

# Logs
*.log

# Claude Code session data
.claude/
